diff --git a/arch/arm64/boot/dts/rockchip/rk3568-yf-023d-v6.dts b/arch/arm64/boot/dts/rockchip/rk3568-yf-023d-v6.dts
new file mode 100644
index 0000000..e49d542
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3568-yf-023d-v6.dts
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * YoungFeel YF-023D v6 (RK3568 + Maxio MAE0621A).
+ * Cloned from proven-booting rk3568-hlink-h68k reference.
+ *
+ * Key differences vs h68k:
+ *   1. Disable "work" LED on GPIO3 B0 (h68k uses it as LED,
+ *      YF-023D uses it as PHY reset).
+ *   2. Add MAC-level snps,reset-gpio on gmac1 (fe010000) so
+ *      stmmac releases PHY reset BEFORE MDIO bus scan.
+ *   3. Keep PHY-level reset-gpios for runtime PHY management.
+ */
+
+/dts-v1/;
+
+#include "rk3568-hlink.dtsi"
+
+/ {
+	model = "YoungFeel YF-023D v6";
+	compatible = "youngfeel,yf-023d-v6", "hlink,h68k", "rockchip,rk3568";
+
+	aliases {
+		ethernet0 = &gmac0;
+		ethernet1 = &gmac1;
+	};
+
+	/* Disable work LED — GPIO3 B0 is needed for PHY reset */
+	leds {
+		status = "disabled";
+	};
+};
+
+/* fe2a0000 — h68k's primary GMAC (uses internal switch, keep as-is) */
+&gmac0 {
+	phy-mode = "rgmii";
+	clock_in_out = "output";
+
+	snps,reset-gpio = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
+	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>, <&cru CLK_MAC0_2TOP>;
+	assigned-clock-rates = <0>, <125000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac0_miim
+		     &gmac0_tx_bus2
+		     &gmac0_rx_bus2
+		     &gmac0_rgmii_clk
+		     &gmac0_rgmii_bus>;
+
+	tx_delay = <0x2e>;
+	rx_delay = <0x28>;
+
+	phy-handle = <&rgmii_phy0>;
+	status = "okay";
+};
+
+/* fe010000 — YF-023D external PHY port (MAE0621A) */
+&gmac1 {
+	phy-mode = "rgmii";
+	clock_in_out = "output";
+
+	/*
+	 * CRITICAL: MAC-level reset BEFORE MDIO bus scan.
+	 * Without this, PHY stays in reset during probe → MDIO reads return 0xFFFF.
+	 */
+	snps,reset-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 20000 100000>;
+
+	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
+	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&cru CLK_MAC1_2TOP>;
+	assigned-clock-rates = <0>, <125000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac1m1_miim
+		     &gmac1m1_tx_bus2
+		     &gmac1m1_rx_bus2
+		     &gmac1m1_rgmii_clk
+		     &gmac1m1_rgmii_bus>;
+
+	tx_delay = <0x42>;
+	rx_delay = <0x25>;
+
+	phy-handle = <&rgmii_phy1>;
+	status = "okay";
+};
+
+&mdio0 {
+	rgmii_phy0: phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+	};
+};
+
+&mdio1 {
+	rgmii_phy1: phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+		/* YF-023D: MAE0621A PHY reset on GPIO3 B0 (validated on hardware) */
+		reset-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <20000>;
+		reset-deassert-us = <100000>;
+	};
+};
