 dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126b-xiaoyu-50ipc.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126b-xiaoyu-50ipc-dual-cam.dtb
 
